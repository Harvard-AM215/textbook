n":1},"end":{"line":72,"column":1}},"key":"LSTx8EWZO3"},{"type":"link","url":"/a-notation","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"Notation & Probability Primer","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"CSGOgUohnK"}],"key":"iv7eWo953w"}],"urlSource":"A_notation.md","dataUrl":"/a-notation.json","internal":true,"protocol":"file","key":"hyulFE3sFR"},{"type":"text","value":" appendix reviews exactly what’s assumed.","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"JbZAYsUzZl"}],"key":"oizQA5kCx4"}],"key":"tPv2MYBw6I"},{"type":"listItem","spread":true,"position":{"start":{"line":73,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"Programming:","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"PHGZRgYxUh"}],"key":"uQuCPAkcgV"},{"type":"text","value":" enough Python to read a short script and change a number in it. The in-page cells are meant to be ","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"ENp9Vc8Mva"},{"type":"emphasis","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"edited","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"Wj408LJ9Xn"}],"key":"hPj1bOahWv"},{"type":"text","value":" — that is most of what you need. Chapters that go further use NumPy, but introduce what they use; you do not need prior experience with any specific modeling library. If you have programmed in another language and never in Python, you are in a fine position to start here.","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"oXEZQ3KUQp"}],"key":"hSWubU83MY"}],"key":"QxBM5IoVEu"}],"key":"RnkaEAanCD"},{"type":"heading","depth":2,"position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"A note on models","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"PaN1VQmU5H"}],"identifier":"a-note-on-models","label":"A note on models","html_id":"a-note-on-models","implicit":true,"key":"vMneUmwR2n"},{"type":"blockquote","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"All models are wrong, but some are useful. — George Box","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"v2uhDeKuvp"}],"key":"yJ58BQHrqk"}],"key":"JJbrgzxCyA"},{"type":"paragraph","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"Every number this book produces comes with an implicit “…assuming the model is right.” A good modeler says that clause out loud, and then goes looking for the evidence that would prove it wrong. That habit — build it, check it against known math, check it against reality, and be honest about the gap — is the whole subject.","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"fdiaHgUXMO"}],"key":"neE5OGTfUM"},{"type":"footnoteDefinition","identifier":"data","label":"data","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":55,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"strong","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"Why isn’t the stock data just committed here, like the exchange rates are?","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"JaMZqGqS9G"}],"key":"LAB6B4EIsL"},{"type":"text","value":"\nBecause we are not allowed to republish it. A stock index is a commercial product\nrather than a public fact — S&P Dow Jones Indices, NASDAQ and CBOE compute, brand and\nlicense their index data, and that is their business. So “free to download” and “free to\nrepublish” are different permissions, and essentially every convenient source grants the\nfirst while withholding the second: FRED carries the S&P 500 but states that reproducing\nit is prohibited without written permission, Yahoo’s terms restrict redistribution, and\nthe academic library this book downloads from carries a copyright notice with no grant\nattached. Fetching it yourself is fine, which is exactly what the Colab path does. The\nexchange rates and Treasury yields ","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"yX7UpuJUyj"},{"type":"emphasis","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"are","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"kMfUER6YCX"}],"key":"VvdJr1r77f"},{"type":"text","value":" committed here because they come from the\nFederal Reserve, whose data carries the label “Public Domain: Citation Requested”\n(Board of Governors of the Federal Reserve System, retrieved from FRED, Federal Reserve\nBank of St. Louis). Baseball results are committed for a third reason: game outcomes are\nfacts, and facts are not copyrightable by anyone.","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"TYcynsWtyS"}],"key":"sb4FuxQDwA"}],"enumerator":"1","key":"r3dyR9CmL4"}],"key":"JBX1HzEUGS"}],"key":"H1X6pbekiJ"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"next":{"title":"Chapter 1: The Modeling Loop — What a Model Is","url":"/modeling-loop","group":"AM115/AM215: A Concise Textbook"}}},"domain":"http://localhost:3000"}